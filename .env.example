# ── AI PROVIDER ────────────────────────────────────────────────
# Provider-agnostic on purpose. Set AI_PROVIDER and the matching key.
# If the hackathon requires Alibaba Model Studio, use "qwen" and nothing
# else in the codebase changes.
#   qwen      -> Alibaba Cloud Model Studio (DashScope, OpenAI-compatible)
#   google    -> Gemini
#   anthropic -> Claude
#   mock      -> no network. Deterministic canned analysis. Demo safety net.
AI_PROVIDER=mock

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-plus

GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=

# ── DATABASE / STORAGE ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

